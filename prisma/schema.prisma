// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//ENUMS

enum KycStatus{
  PENDING
  VERIFIED
  REJECTED
}

enum MobileMoneyProvider{
  AIRTEL
  TNM
}

enum SavingsType{
  TIME_BASED
  TARGET_BASED
}

enum SavingsStatus{
  ACTIVE
  COMPLETED
  CANCELLED
  PAUSED
}

enum WithdrawPolicy{
  LOCKED
  FLEXIBLE
}

enum TransactionStatus{
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REVERSED
}

enum PaymentStatus{
  INITIATED
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum WebhookStatus{
  RECEIVED
  PROCESSED
  FAILED
}
enum TransactionType {
  DEPOSIT
  WITHDRAWAL
}

model User{
  id String @id @default(cuid())
  firstName String
  lastName String
  fullName String
  email String @unique
  phoneNumber String @unique
  passwordHash String
  kycStatus kycStatus @default(PENDING)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  kycVerification kycVerification?
  mobileMoneyAccounts mobileMoneyAccount[]
  savingsAccounts savingsAccount[]
  auditLogs auditLog[]
  @@index([email])
  @@index([phone])
  @@map("users")
}

model KycVerification{
  id String @id default(cuid())
  userId String @unique
  user user @relation(fields:[userId], references:[id], onDelete:Cascade)
  idType String
  idNumber String
  status KycStatus @default(PENDING)
  verifiedAt DateTime?
  rejectedReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map ("kyc_verifications")
}

model savingsAccount{
  id String @id @default(cuid())
  userId String
  user user@relation(fields:[userId], references:[id], onDelete:Cascade)
  name String
  type SavingsType
  status SavingsStatus @default(ACTIVE)
  balance Decimal @default(0) @db.decimal(18,20)
  WithdrawPolicy WithdrawPolicy
  penaltyPercentage Decimal @default(5) @db.decimal(5,2)
  maturedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  timeBasedDetails TimeBasedSavings?
  targetBasedDetails TargetBasedSavings?
  transactions Transaction[]
  @@index([userId])
  @@index ([status])

  @@map ("savings_accounts)

}
 model TimeBasedSavings{
  id String @ID @default(cuid())
  savingsAccountId String @unique
  savingsAccount savingsAccount @relation (fields:[savingsAccountId], references:[id], onDelete:Cascade)
  startDate DateTime @default(now())
  maturityDate DateTime
  @@map("time_based_savings")
 }

 model TargetBasedSavings{
  id String @id @default(cuid())
  savingsAccountId String @unique
  savingsAccount savingsAccount @relation(fields:[savingsAccountId], references:[id], onDelete:Cascade)
  target Decimal @db.Decimal(18,2)
  @@map("target_based_savings")
 }

model Transaction{
  id String @id @default(cuid())
  date DateTime @default(now())
  from String?
  to String?
  savingsAccountId String @unique
  savingsAccount savingsAccount @relation(fields:[savingsAccountId], references:[id], onDelete:Restrict)
type TransactionType
amount Decimal @db.Decimal(18,2)
status TransactionStatus @default (PENDING)
providerReference String?
idempotencyKey String @unique
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
  paymentGatewayTransaction PaymentGatewayTransaction?



  @@index([savingsAccountId])

  @@index([mobileMoneyAccountId])

  @@index([status])


  @@map("transactions")

}


model PaymentGatewayTransaction {


  id String @id @default(cuid())


  transactionId String @unique


  transaction Transaction @relation(
    fields:[transactionId],
    references:[id],
    onDelete:Cascade
  )



  provider MobileMoneyProvider



  gatewayReference String?



  status PaymentStatus
    @default(INITIATED)



  responsePayload Json?



  webhookEvents WebhookEvent[]



  createdAt DateTime @default(now())


  updatedAt DateTime @updatedAt



  @@map("payment_gateway_transactions")

}




model WebhookEvent {


  id String @id @default(cuid())



  paymentGatewayTransactionId String



  paymentGatewayTransaction PaymentGatewayTransaction @relation(
    fields:[paymentGatewayTransactionId],
    references:[id],
    onDelete:Cascade
  )



  providerEventId String @unique



  payload Json



  status WebhookStatus
    @default(RECEIVED)



  receivedAt DateTime @default(now())


  processedAt DateTime?



  errorMessage String?



  @@index([status])


  @@map("webhook_events")
}



model AuditLog {

  id String @id @default(cuid())


  userId String?


  user User? @relation(
    fields:[userId],
    references:[id],
    onDelete:SetNull
  )



  action String


  entityType String


  entityId String


  metadata Json?



  createdAt DateTime @default(now())



  @@index([userId])


  @@index([
    entityType,
    entityId
  ])


  @@map("audit_logs")

}