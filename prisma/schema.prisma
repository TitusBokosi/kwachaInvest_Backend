// This is your Prisma schema file.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  USER
  ADMIN
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum MobileMoneyProvider {
  AIRTEL
  TNM
}

enum SavingsType {
  TIME_BASED
  TARGET_BASED
}

enum SavingsStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  PAUSED
  FROZEN
}

enum WithdrawalPolicy {
  LOCKED
  FLEXIBLE
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
}

enum TransactionStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REVERSED
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum OtpPurpose {
  PASSWORD_RESET
}

enum PaymentMode {
  HOSTED_CHECKOUT
  DIRECT_MOBILE_MONEY
}

// ============================================================================
// USERS
// ============================================================================

model User {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  fullName     String
  email        String   @unique
  phoneNumber  String   @unique
  passwordHash String

  role UserRole @default(USER)

  kycStatus KycStatus @default(PENDING)
  isActive  Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kycVerification     KycVerification?
  mobileMoneyAccounts MobileMoneyAccount[]
  savingsAccounts     SavingsAccount[]
  auditLogs           AuditLog[]
  authSessions        AuthSession[]
  otpCodes            OtpCode[]

  @@index([email])
  @@index([phoneNumber])
  @@map("users")
}

// ============================================================================
// AUTH
// ============================================================================

model AuthSession {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // SHA-256 hash of the refresh token — the raw token is only ever returned
  // to the client once, at login/refresh time, and never stored.
  tokenHash String @unique

  deviceInfo String?
  ipAddress  String?

  expiresAt  DateTime
  revokedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("auth_sessions")
}

model OtpCode {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // bcrypt hash of the OTP — unlike the refresh token above, OTPs are
  // low-entropy (6 digits), so a slow hash is used to resist brute force.
  codeHash String

  purpose OtpPurpose

  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int       @default(0)

  createdAt DateTime @default(now())

  @@index([userId, purpose])
  @@map("otp_codes")
}

// ============================================================================
// KYC
// ============================================================================

model KycVerification {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  idType   String
  idNumber String

  status KycStatus @default(PENDING)

  verifiedAt     DateTime?
  rejectedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("kyc_verifications")
}

// ============================================================================
// MOBILE MONEY
//
// This is now a "saved payment method" — a convenience record created AFTER
// a successful Direct Charge, not a prerequisite the user sets up in advance.
// A deposit can supply provider + phoneNumber fresh every time; savedAccount
// is optional and just lets the client skip re-typing a number next time.
// ============================================================================

model MobileMoneyAccount {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider MobileMoneyProvider

  // PayChangu's own opaque id for this operator (mobile_money_operator_ref_id)
  // — cached here so a repeat Direct Charge against a saved method doesn't
  // need to re-fetch GET /mobile-money every time.
  operatorRefId String

  phoneNumber String

  // True once at least one Direct Charge against this provider+phoneNumber
  // has actually succeeded — a real successful charge is a stronger
  // verification signal than a separate upfront OTP step would be.
  isVerified Boolean @default(false)

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Scoped to the user — the old global @@unique([provider, phoneNumber])
  // would have meant only one user in the entire system could ever save a
  // given phone number, which is wrong; a number is only unique per-user here.
  @@unique([userId, provider, phoneNumber])
  @@index([userId])
  @@map("mobile_money_accounts")
}

// ============================================================================
// SAVINGS
// ============================================================================

model SavingsAccount {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String

  type SavingsType

  status SavingsStatus @default(ACTIVE)

  balance Decimal @default(0) @db.Decimal(18, 2)

  withdrawalPolicy WithdrawalPolicy

  penaltyPercentage Decimal @default(5) @db.Decimal(5, 2)

  maturedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timeBasedDetails   TimeBasedSavings?
  targetBasedDetails TargetBasedSavings?

  transactions Transaction[]

  @@index([userId])
  @@index([status])
  @@map("savings_accounts")
}

model TimeBasedSavings {
  id String @id @default(cuid())

  savingsAccountId String         @unique
  savingsAccount   SavingsAccount @relation(fields: [savingsAccountId], references: [id], onDelete: Cascade)

  startDate DateTime @default(now())

  maturityDate DateTime

  @@map("time_based_savings")
}

model TargetBasedSavings {
  id String @id @default(cuid())

  savingsAccountId String         @unique
  savingsAccount   SavingsAccount @relation(fields: [savingsAccountId], references: [id], onDelete: Cascade)

  target Decimal @db.Decimal(18, 2)

  @@map("target_based_savings")
}

// ============================================================================
// TRANSACTIONS
// ============================================================================

model Transaction {
  id String @id @default(cuid())

  savingsAccountId String
  savingsAccount   SavingsAccount @relation(fields: [savingsAccountId], references: [id], onDelete: Restrict)

  // Optional — only set if the deposit reused a saved payment method.
  // The actual provider/phoneNumber charged are captured below regardless,
  // since Direct Charge always requires them fresh at charge time.
  mobileMoneyAccountId String?
  mobileMoneyAccount   MobileMoneyAccount? @relation(fields: [mobileMoneyAccountId], references: [id], onDelete: SetNull)

  provider MobileMoneyProvider
  payerPhoneNumber String

  type TransactionType

  amount Decimal @db.Decimal(18, 2)

  status TransactionStatus @default(PENDING)

  providerReference String? @unique

  idempotencyKey String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paymentGatewayTransaction PaymentGatewayTransaction?

  @@index([savingsAccountId])
  @@index([mobileMoneyAccountId])
  @@index([status])
  @@map("transactions")
}

// ============================================================================
// PAYMENT GATEWAY
// ============================================================================

model PaymentGatewayTransaction {
  id String @id @default(cuid())

  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  mode PaymentMode

  // PayChangu's own charge_id / tx reference for this charge.
  gatewayReference String?

  status PaymentStatus @default(INITIATED)

  // Raw response from PayChangu's initialize + verify calls, kept for
  // replay/audit and to avoid losing anything we didn't explicitly model.
  responsePayload Json?

  webhookEvents WebhookEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payment_gateway_transactions")
}

model WebhookEvent {
  id String @id @default(cuid())

  paymentGatewayTransactionId String
  paymentGatewayTransaction   PaymentGatewayTransaction @relation(fields: [paymentGatewayTransactionId], references: [id], onDelete: Cascade)

  providerEventId String @unique

  payload Json

  status WebhookStatus @default(RECEIVED)

  receivedAt DateTime @default(now())

  processedAt DateTime?

  errorMessage String?

  @@index([status])
  @@map("webhook_events")
}

// ============================================================================
// AUDIT LOGS
// ============================================================================

model AuditLog {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action String

  entityType String

  entityId String

  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
