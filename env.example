NODE_ENV=development
PORT=4000

# Postgres connection string (used by both the Prisma CLI and the app's
# runtime adapter-pg client)
DATABASE_URL=postgresql://user:password@localhost:5432/kwachainvest

# JWT
JWT_SECRET=replace-with-a-random-string-at-least-32-characters-long
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=10

# Public base URL of this API (used to build the PayChangu webhook callback URL)
APP_BASE_URL=https://api.kwachainvest.mw

# PayChangu
PAYCHANGU_SECRET_KEY=
PAYCHANGU_WEBHOOK_SECRET=
PAYCHANGU_BASE_URL=https://api.paychangu.com

# SMTP (email notifications, password reset OTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="KwachaInvest <no-reply@kwachainvest.mw>"

# Redis (reserved for future BullMQ/queues work — optional for now)
REDIS_URL=
