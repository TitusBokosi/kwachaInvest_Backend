NODE_ENV=test
PORT=4000

# Needs a REAL running Postgres for anything that touches the DB to work.
# If you have Postgres installed locally with default settings, this may
# already work as-is once you create the database:
#   createdb kwachainvest
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kwachainvest

# Mock secret — long enough to pass validation, but replace before anything
# that matters. Generate a real one with: openssl rand -hex 32
JWT_SECRET=mock_jwt_secret_change_me_before_launch_1234567890
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=10

APP_BASE_URL=http://localhost:4000

# Fake — passes validation, but any real call to PayChangu will fail auth
# until you swap in your real sandbox/live keys from their dashboard.
PAYCHANGU_SECRET_KEY=mock_paychangu_secret_key
PAYCHANGU_WEBHOOK_SECRET=mock_paychangu_webhook_secret
PAYCHANGU_BASE_URL=https://api.paychangu.com

# Fake — passes validation, but real emails (OTP, welcome, deposit/withdrawal
# notices) will silently fail to send (notification.service.js swallows the
# error and logs it, so this won't crash the app — just check your terminal
# logs if you're testing password reset and no email shows up).
SMTP_HOST=smtp.mock.local
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mock_smtp_user
SMTP_PASSWORD=mock_smtp_password
SMTP_FROM="KwachaInvest <no-reply@kwachainvest.mw>"

REDIS_URL=
